PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/student_course_db
# Required. Use a long random string, e.g. the output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Used by `npm run seed` when creating the admin account
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=Admin@123
